# ----- 기본 -----
DATABASE_URL=postgresql+psycopg://caremate:caremate@localhost:5433/caremate_v2

OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=20

STT_PROVIDER=openai
STT_MODEL=gpt-4o-mini-transcribe
STT_TIMEOUT_SECONDS=30
STT_LANGUAGE=ko

TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_TIMEOUT_SECONDS=30
TTS_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3

MAP_API_KEY=
PUBLIC_DATA_API_KEY=
ALERT_SWEEP_TOKEN=

# ----- AI 모델 설정 -----
# GPU 사용 시: cuda:0 / CPU 사용 시: cpu
AI_MODEL_DEVICE=cpu

# WAV 모델 threshold (0.0 ~ 1.0)
COGNITIVE_WAV_THRESHOLD=0.5
DEPRESSION_WAV_THRESHOLD=0.5
INSOMNIA_WAV_THRESHOLD=0.5

# 일별 인지 점수 통합 가중치 (합=1.0)
COGNITIVE_WAV_DAILY_WEIGHT=0.5
COGNITIVE_TEXT_DAILY_WEIGHT=0.5

# 오디오 설정
AUDIO_SAMPLE_RATE=16000
AUDIO_MAX_SECONDS=10

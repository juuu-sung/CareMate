{
  "expo": {
    "name": "CareMate",
    "slug": "caremate",
    "scheme": "caremate",
    "ios": {
      "bundleIdentifier": "com.kimjaeho.caremate",
      "jsEngine": "jsc",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "CareMate가 '케어'를 인식해 바로 대화를 시작하려면 음성 인식 접근이 필요합니다.",
        "NSMicrophoneUsageDescription": "CareMate가 음성 대화와 웨이크워드를 위해 마이크 접근이 필요합니다."
      }
    },
    "plugins": [
      "expo-router",
      "./plugins/withCareBuildFromSource",
      [
        "./plugins/withCareSiriShortcuts",
        {
          "appSynonym": "케어",
          "spokenName": "케어"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "CareQuickStartWidget",
              "displayName": "케어 대화",
              "description": "한 번 눌러 바로 음성 대화를 시작합니다.",
              "supportedFamilies": [
                "systemSmall",
                "accessoryCircular",
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": false
            }
          ]
        }
      ],
      "./plugins/withCareWidgetsPodsFix",
      [
        "./plugins/withCareWidgetUrls",
        {
          "widgets": [
            {
              "name": "CareQuickStartWidget",
              "url": "caremate:///chat?input=voice&autostart=1&source=widget"
            }
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "CareMate가 음성 대화와 웨이크워드를 위해 마이크 접근이 필요합니다."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "CareMate가 음성 대화와 웨이크워드를 위해 마이크 접근이 필요합니다.",
          "speechRecognitionPermission": "CareMate가 '케어'를 인식해 바로 대화를 시작하려면 음성 인식 접근이 필요합니다."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CareMate가 가까운 병원을 찾기 위해 현재 위치 접근이 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.kimjaeho.caremate"
    }
  }
}
